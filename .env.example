# Copy to .env and fill in only what you need (.env is git-ignored).
# A variable already set in the environment wins over the value in this file.
# `uv run videoforge doctor` shows which keys and SDKs are available.

# --- Provider keys -----------------------------------------------------------
# Google Gemini: images (Nano Banana), text, and vision checks
GEMINI_API_KEY=
# fal.ai: image-to-video (Hailuo and other presets)
FAL_KEY=
# ElevenLabs: optional TTS provider
ELEVENLABS_API_KEY=
# RunPod: rented GPU running ComfyUI (`videoforge gpu up|down|status`)
RUNPOD_API_KEY=
# VF_RUNPOD_KEY_VAR=RUNPOD_API_KEY   # name of the variable that holds the RunPod key
# Hugging Face token for gated model downloads on the GPU pod (tools/pod_iclora.py)
HF_TOKEN=
# YouTube upload / analytics: OAuth client from Google Cloud (see docs/PUBLISHING.md)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Provider selection ------------------------------------------------------
# "mock" is a free implementation of every provider (coloured frames, Ken Burns
# instead of animation, silence instead of a voice): the whole pipeline runs at $0.
# VF_IMAGE_PROVIDER=gemini      # gemini | comfy | mock
# VF_VIDEO_PROVIDER=fal         # fal | remotion | comfy | mock
#                               # remotion: programmatic camera moves, $0, needs Node.js
# VF_STILL_PROVIDER=            # renderer for still scenes (remotion | mock)
# VF_TTS_PROVIDER=edge          # edge | elevenlabs | mock
# VF_LLM_PROVIDER=gemini        # gemini | claude_cli | mock
# VF_CHECK_PROVIDER=            # frame/clip checker: gemini | mock (empty = same as LLM)
# VF_INTEL_LLM_PROVIDER=        # LLM for the analyze_channel workflow
# VF_SEARCH_PROVIDER=           # reference image search: commons | mock | none
# VF_PUBLISH_PROVIDER=          # youtube_api | browser | mock (default depends on platform)
# VF_VISION_CHECK=              # off: no automatic frame/clip checks, the human decides at gates
# VF_FRAME_REVIEW=              # off: no QA frame review

# --- Models and tuning -------------------------------------------------------
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# VF_GEMINI_RPM=15              # Gemini calls per minute per model; 0 = unlimited
# FAL_VIDEO_PRESET=hailuo-02-fast   # see videoforge/providers/fal_video.py
# FAL_VIDEO_ENDPOINT=               # override the fal endpoint entirely
# VF_ELEVENLABS_MODEL=
# VF_CLAUDE_CLI_MODEL=
# VF_CLAUDE_CLI_TIMEOUT=
# VF_WHISPER_MODEL=             # faster-whisper model (uv sync --extra transcribe)
# VF_WHISPER_DEVICE=            # cpu | cuda
# VF_EMOJI_FONT=                # colour emoji font for clip headlines (default: Segoe UI Emoji)

# --- ComfyUI on a rented GPU ------------------------------------------------
# VF_COMFY_URL=
# VF_COMFY_LORA=
# VF_COMFY_VIDEO=
# VF_COMFY_LTX_VAE=
# VF_COMFY_RATE_USD_HR=         # hourly rate used for cost tracking

# --- Data locations (default: next to the code) ------------------------------
# VF_PROJECTS_DIR=
# VF_RESOURCES_DIR=
# VF_LIBRARY_DIR=
# VF_WORKFLOWS_DIR=
