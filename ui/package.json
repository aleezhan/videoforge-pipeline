{
  "name": "videoforge-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Интерфейс videoforge: просмотрщик поверх файлов конвейера. Данные отдаёт `videoforge ui` (FastAPI), сборка кладётся в dist/ и раздаётся тем же сервером.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.2.2"
  }
}
